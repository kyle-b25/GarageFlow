# ─── Flask ────────────────────────────────────────────────────────
FLASK_APP=app.py
FLASK_ENV=development          # development | testing | production
FLASK_DEBUG=1                  # Set to 0 in production

# ─── Security ────────────────────────────────────────────────────
# Required in production (min 12 chars). Omit in dev to use a random key.
SECRET_KEY=change-me-to-a-real-secret

# ─── Database ────────────────────────────────────────────────────
# SQLite (default) or PostgreSQL connection string
DATABASE_URL=sqlite:///database.db
# DATABASE_URL=postgresql://user:password@localhost:5432/garageflow

# ─── Stripe (optional — payments degrade gracefully without these) ─
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# ─── CORS ────────────────────────────────────────────────────────
# Comma-separated origins. Leave empty to allow all origins (*).
CORS_ORIGINS=

# ─── Congestion Alert ───────────────────────────────────────────
# Occupancy ratio (0.0–1.0) that triggers the congestion alert.
CONGESTION_THRESHOLD=0.85

# ─── Notifications (optional — features degrade gracefully) ─────
# SendGrid for email notifications
SENDGRID_API_KEY=SG.your_sendgrid_api_key
NOTIFICATION_FROM_EMAIL=noreply@garageflow.example.com

# Twilio for SMS notifications
TWILIO_ACCOUNT_SID=ACyour_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567
